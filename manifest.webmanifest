{
  "id": "./",
  "name": "Jesus Christ Redeems Global Ministries",
  "short_name": "JCRGM",
  "description": "Jesus Christ Redeems Global Ministries — services, giving, transport desk, event music and church growth tools. Install for one-tap access and offline reading.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#101d44",
  "theme_color": "#101d44",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "lifestyle",
    "education",
    "social"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Join JCRGM — Newcomer",
      "short_name": "Join JCRGM",
      "description": "Application for visitors and new persons wishing to join the ministry",
      "url": "./join-jcrgm.html",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Transport Desk",
      "short_name": "Transport",
      "description": "Request church transport or a Yango ride",
      "url": "./index.html?open=transport",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Install / Share",
      "short_name": "Install",
      "description": "Install JCRGM on this device or share the link",
      "url": "./install.html",
      "icons": [
        {
          "src": "assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
